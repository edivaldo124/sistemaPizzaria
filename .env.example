# Copie para .env e gere valores novos. Nunca versione o arquivo .env.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
DEBUG=true

# Desenvolvimento local: SQLite, zero configuração.
DATABASE_URL=sqlite:///pizzaria_dev.db

# Produção no Vercel com Supabase (Connect > Transaction pooler, porta 6543):
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Para rodar migrations do seu computador, use a Session pooler (mesma URL, porta 5432).

# true em produção (HTTPS).
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://

# URL pública da aplicação, necessária para o retorno e webhook do Mercado Pago.
# Em desenvolvimento com túnel HTTPS, use a URL do túnel.
PUBLIC_BASE_URL=https://sua-url-publica.example
INTEGRATION_HTTP_TIMEOUT=10
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-token-privado
MERCADOPAGO_API_URL=https://api.mercadopago.com
MERCADOPAGO_CHECKOUT_PATH=/checkout/preferences
MERCADOPAGO_PAYMENT_PATH=/v1/payments
PAYMENT_CURRENCY=BRL

# Gmail API no Google Cloud.
# Você pode usar um access token fixo ou um refresh token OAuth do Google.
# Escopo necessário: https://www.googleapis.com/auth/gmail.send
GMAIL_FROM=pedidos@suaempresa.com
GMAIL_ACCESS_TOKEN=seu-access-token-gmail
GMAIL_USER_ID=me
GMAIL_API_URL=https://gmail.googleapis.com/gmail/v1

# OAuth do Google (opcional quando GMAIL_ACCESS_TOKEN não é usado)
GOOGLE_CLIENT_ID=seu-client-id-google
GOOGLE_CLIENT_SECRET=seu-client-secret-google
GOOGLE_REFRESH_TOKEN=seu-refresh-token-google

# Google Maps Distance Matrix API no Google Cloud.
# Restrinja a chave por API e por domínio/IP no Console Google Cloud.
GOOGLE_MAPS_API_KEY=sua-chave-restrita
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api/distancematrix/json
GOOGLE_MAPS_WEB_URL=https://www.google.com/maps/dir/
GOOGLE_MAPS_LANGUAGE=pt-BR
GOOGLE_MAPS_UNITS=metric
DELIVERY_ORIGIN=Rua da Pizzaria, 100, Palmas, TO
